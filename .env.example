# GROQ_API_KEY: Optional key for the secondary Groq LLM used by the Python
# LangGraph service for annotations and faithfulness audits.
GROQ_API_KEY="your_groq_api_key_here"
GROQ_MODEL="openai/gpt-oss-20b"

# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional local development ports.
PORT="3000"
VITE_HMR_PORT="3001"
# Set to "true" to disable the Vite WebSocket used for hot reload.
DISABLE_HMR="false"

# Legal source retrieval. Sources are fetched by the Python service and cached
# outside version control; stale cache is used if an official site is offline.
LEGAL_SOURCE_CACHE_DIR=".cache/legal-sources"
LEGAL_SOURCE_CACHE_TTL_HOURS="168"
LEGAL_SOURCE_TIMEOUT_SECONDS="8"
